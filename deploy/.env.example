# Copy to deploy/.env and fill. Never commit deploy/.env.
# Generate APP_KEY with: php artisan key:generate --show  (or openssl rand -base64 32)
APP_KEY=
DB_PASSWORD=          # strong random password for the eventra_app MySQL user
APP_HOST=app.example.com
API_HOST=api.example.com
REGISTRY=ghcr.io
IMAGE_PREFIX=YOUR_GITHUB_USERNAME
TAG=latest
